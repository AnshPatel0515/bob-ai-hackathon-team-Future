# ============================================================
#  supply-chain-api Configuration Environment File
#  Rename to .env and configure your PostgreSQL settings
# ============================================================


PORT=3000
NODE_ENV=development

# ── PostgreSQL Database Connection (pgAdmin 4 settings) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=team-Future
DB_USER=postgres
DB_PASSWORD=123456
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000
DB_SSL=false

DATABASE_URL=postgresql://postgres:Swami@123localhost:5432/PostgreSQLLocal

# ── JWT Authentication ──
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=8h

# ── CORS Origins ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
